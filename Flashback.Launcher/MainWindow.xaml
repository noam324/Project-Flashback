<Window x:Class="Flashback.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Flashback"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#080808"
        Foreground="White"
        ResizeMode="CanResize">

    <Window.Resources>

        <SolidColorBrush x:Key="GoldBrush"
                         Color="#D4AF37"/>

        <SolidColorBrush x:Key="GoldLightBrush"
                         Color="#F2D675"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#101010"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#8E8E8E"/>

        <Style x:Key="GoldButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#080808"/>

            <Setter Property="Background"
                    Value="{StaticResource GoldBrush}"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{StaticResource GoldLightBrush}"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.35"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#B0B0B0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

            <Setter Property="Margin"
                    Value="0,2"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1A1A1A"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- LOGIN PAGE -->

        <Grid x:Name="LoginPage"
              Visibility="Visible"
              Background="#080808">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        Width="460"
                        HorizontalAlignment="Center">

                <TextBlock Text="PROJECT FLASHBACK"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{StaticResource GoldBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="THE CLASSIC EXPERIENCE"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,35"/>

                <Border Background="#101010"
                        BorderBrush="#242424"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="35">

                    <StackPanel>

                        <TextBlock Text="Welcome"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Sign in with Discord to continue"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,28"/>

                        <Button x:Name="DiscordLoginButton"
                                Content="LOGIN WITH DISCORD"
                                Style="{StaticResource GoldButtonStyle}"
                                Height="52"
                                Click="DiscordLoginButton_Click"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Ready to sign in."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,18,0,0"/>

                    </StackPanel>

                </Border>

                <TextBlock Text="Unofficial fan-made project"
                           Foreground="#5F5F5F"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>

            </StackPanel>

        </Grid>

        <!-- MAIN APPLICATION -->

        <Grid x:Name="HomePage"
              Visibility="Collapsed"
              Background="#080808">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="250"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->

            <Border Grid.Column="0"
                    Background="#0D0D0D"
                    BorderBrush="#1D1D1D"
                    BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="24,28,24,25">

                        <TextBlock Text="FLASHBACK"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"/>

                        <TextBlock Text="12.50"
                                   FontSize="12"
                                   Foreground="#777777"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="14,0">

                        <Button Content="HOME"
                                Style="{StaticResource NavButtonStyle}"
                                Click="HomeButton_Click"/>

                        <Button Content="DOWNLOAD"
                                Style="{StaticResource NavButtonStyle}"
                                Click="DownloadNavButton_Click"/>

                        <Button Content="LOCKER"
                                Style="{StaticResource NavButtonStyle}"
                                Click="LockerButton_Click"/>

                        <Button Content="TOURNAMENTS"
                                Style="{StaticResource NavButtonStyle}"
                                Click="TournamentsButton_Click"/>

                        <Button Content="LEADERBOARDS"
                                Style="{StaticResource NavButtonStyle}"
                                Click="LeaderboardsButton_Click"/>

                        <Button Content="SETTINGS"
                                Style="{StaticResource NavButtonStyle}"
                                Click="SettingsButton_Click"/>

                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#131313"
                            Margin="14,14,14,18"
                            Padding="14"
                            CornerRadius="10">

                        <StackPanel>

                            <TextBlock Text="ACCOUNT"
                                       FontSize="10"
                                       Foreground="#777777"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="HomeUsernameText"
                                       Text="PLAYER"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- MAIN CONTENT -->

            <Grid Grid.Column="1"
                  Margin="34">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- HEADER -->

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,28">

                    <TextBlock x:Name="PageTitleText"
                               Text="HOME"
                               FontSize="31"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PageSubtitleText"
                               Text="Welcome back"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- HOME -->

                <Grid x:Name="HomeContent"
                      Grid.Row="1"
                      Visibility="Visible">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <StackPanel>

                                    <TextBlock Text="WELCOME BACK"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}"/>

                                    <TextBlock x:Name="WelcomeText"
                                               Text="Welcome back, PLAYER"
                                               FontSize="29"
                                               FontWeight="Bold"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="Your Project Flashback account is ready."
                                               FontSize="14"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,7,0,0"/>

                                </StackPanel>

                            </Border>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource CardStyle}"
                                        Margin="0,0,8,0">

                                    <StackPanel>

                                        <TextBlock Text="LEVEL"
                                                   FontSize="11"
                                                   Foreground="#777777"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="LevelText"
                                                   Text="1"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource GoldBrush}"
                                                   Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}"
                                        Margin="8,0">

                                    <StackPanel>

                                        <TextBlock Text="FLASHBACK CREDITS"
                                                   FontSize="11"
                                                   Foreground="#777777"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="CreditsText"
                                                   Text="0"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource GoldBrush}"
                                                   Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}"
                                        Margin="8,0,0,0">

                                    <StackPanel>

                                        <TextBlock Text="BUILD"
                                                   FontSize="11"
                                                   Foreground="#777777"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="12.50"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource GoldBrush}"
                                                   Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,18,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="READY TO PLAY?"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="Launch your installed classic build."
                                                   FontSize="13"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            x:Name="PlayNowButton"
                                            Content="PLAY NOW"
                                            Width="150"
                                            Height="48"
                                            Style="{StaticResource GoldButtonStyle}"
                                            Click="PlayNowButton_Click"/>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <!-- DOWNLOAD -->

                <Grid x:Name="DownloadContent"
                      Grid.Row="1"
                      Visibility="Collapsed">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,0,18">

                                <StackPanel>

                                    <TextBlock Text="CLASSIC BUILD"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}"/>

                                    <TextBlock Text="Fortnite 12.50"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>

                                    <TextBlock Text="CL 13137020"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,0"/>

                                    <TextBlock x:Name="DownloadStatusText"
                                               Text="BUILD NOT INSTALLED"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}"
                                               Margin="0,20,0,0"/>

                                    <TextBlock x:Name="DownloadDetailsText"
                                               Text="Build 12.50 • CL 13137020"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>

                                    <TextBlock x:Name="DownloadEtaText"
                                               Text="Download the build to continue."
                                               Foreground="#777777"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                    <ProgressBar x:Name="DownloadProgress"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 Visibility="Collapsed"
                                                 Margin="0,22,0,15"/>

                                </StackPanel>

                            </Border>

                            <WrapPanel>

                                <Button x:Name="PlayBuildButton"
                                        Content="PLAY BUILD"
                                        Width="150"
                                        Height="48"
                                        Margin="0,0,10,10"
                                        Style="{StaticResource GoldButtonStyle}"
                                        IsEnabled="False"
                                        Click="PlayBuildButton_Click"/>

                                <Button x:Name="DownloadButton"
                                        Content="DOWNLOAD"
                                        Width="150"
                                        Height="48"
                                        Margin="0,0,10,10"
                                        Style="{StaticResource GoldButtonStyle}"
                                        Click="DownloadButton_Click"/>

                                <Button x:Name="LocateBuildButton"
                                        Content="LOCATE BUILD"
                                        Width="150"
                                        Height="48"
                                        Margin="0,0,10,10"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="LocateBuildButton_Click"/>

                                <Button x:Name="CancelDownloadButton"
                                        Content="CANCEL"
                                        Width="150"
                                        Height="48"
                                        Margin="0,0,10,10"
                                        Style="{StaticResource NavButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="CancelDownloadButton_Click"/>

                            </WrapPanel>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <!-- PLACEHOLDER -->

                <Grid x:Name="PlaceholderContent"
                      Grid.Row="1"
                      Visibility="Collapsed">

                    <Border Style="{StaticResource CardStyle}"
                            VerticalAlignment="Top">

                        <StackPanel>

                            <TextBlock x:Name="PlaceholderTitle"
                                       Text="COMING SOON"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"/>

                            <TextBlock x:Name="PlaceholderDescription"
                                       Text="This section is coming soon."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>